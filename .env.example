# Both variables are optional; the tools run with none set.

# Address search uses OpenStreetMap's Nominatim. Its usage policy asks for a User-Agent that names
# your app and gives a contact.
NOMINATIM_USER_AGENT="YourApp/1.0 (you@example.org)"

# Rate limiting for the search routes is in memory per server instance. Set these to share limits
# across instances with Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
